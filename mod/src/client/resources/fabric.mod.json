{
  "schemaVersion": 1,
  "id": "chesttracker",
  "version": "${version}",
  "name": "ChestTracker Multiplayer Sync",
  "description": "Client-side Chest Tracker with shared multiplayer memories through a self-hosted CMSync server.",
  "authors": [
    "JackFred",
    "ponuing",
    "usernamelocker"
  ],
  "contributors": [
    "WinTone01 - Turkish Translations"
  ],
  "contact": {
    "homepage": "https://github.com/usernamelocker/chesttrackermultiplayersync",
    "sources": "https://github.com/usernamelocker/chesttrackermultiplayersync",
    "issues": "https://github.com/usernamelocker/chesttrackermultiplayersync/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/chesttracker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "red.jackf.chesttracker.impl.ChestTracker"
    ],
    "chesttracker": [
      "red.jackf.chesttracker.impl.DefaultChestTrackerPlugin"
    ],
    "modmenu": [
      "red.jackf.chesttracker.impl.compat.mods.ChestTrackerModMenu"
    ],
    "whereisit_client": [
      "red.jackf.chesttracker.impl.compat.mods.ChestTrackerWhereIsItPlugin"
    ],
    "shulkerboxtooltip": [
      "red.jackf.chesttracker.impl.compat.mods.shulkerboxtooltip.ChestTrackerShulkerBoxTooltip"
    ],
    "jade": [
      "red.jackf.chesttracker.impl.compat.mods.jade.ChestTrackerJadePlugin"
    ]
  },
  "mixins": [
    {
      "config": "chesttracker.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "chesttracker.accesswidener",
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.issues": "https://github.com/usernamelocker/chesttrackermultiplayersync/issues",
        "modmenu.github_releases": "https://github.com/usernamelocker/chesttrackermultiplayersync/releases"
      }
    }
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.9.4"
  },
  "recommends": {
    "searchables": "*"
  },
  "suggests": {
    "modmenu": "*",
    "shulkerboxtooltip": "*",
    "wthit": "*",
    "jade": "*"
  }
}
