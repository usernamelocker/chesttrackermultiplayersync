# Copy to .env (or export env vars). Server reads env with these defaults.
EXPECTED_SERVER_ID=multiplayer/fabriccraft_net
# Extra addresses for the SAME proxy/network, merged into the bank above.
# fabriccraft.net -> multiplayer/fabriccraft_net (canonical, tell players to use this one)
# vip.fabriccraft.net -> multiplayer/vip_fabriccraft_net (alias, still merges)
SERVER_ID_ALIASES=multiplayer/vip_fabriccraft_net
# --- access mode: pick ONE ---
# UUID mode: comma-separated whitelisted player UUIDs (token optional extra)
# WHITELIST_UUIDS=aaa,bbb
# Token mode: leave WHITELIST_UUIDS empty and set a password instead.
# Everyone with the password can sync, no UUID list needed.
WHITELIST_UUIDS=
# single shared password required via X-CMSync-Token header (empty = no token check)
SHARED_TOKEN=
# admin token for /api/restore (defaults to SHARED_TOKEN if empty)
# WARNING: escape every $ as $$ in Portainer/docker-compose env values,
# or compose eats them ($W -> empty) and the stored token won't match!
ADMIN_TOKEN=
DB_PATH=data/cmsync.db
SNAPSHOT_INTERVAL_MIN=15
SNAPSHOT_KEEP=96
MAX_DELETE_FRACTION=0.20
MAX_DELETE_COUNT=50
MIN_QUARANTINE_BANK=10
# pull range gate (blocks): far-away containers are withheld from pull responses
RANGE_BLOCKS=5000
TOMBSTONE_TTL_DAYS=30
HOST=127.0.0.1
PORT=8000
