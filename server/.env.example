# Copy to .env (or export env vars). Server reads env with these defaults.
EXPECTED_SERVER_ID=multiplayer/mc_example_com
# comma-separated whitelisted player UUIDs (authoritative; empty = deny all)
WHITELIST_UUIDS=
# optional: single shared token required via X-CMSync-Token header (empty = no token check)
SHARED_TOKEN=
# optional: admin token for /api/restore (defaults to SHARED_TOKEN if empty)
ADMIN_TOKEN=
DB_PATH=data/cmsync.db
SNAPSHOT_INTERVAL_MIN=15
SNAPSHOT_KEEP=96
MAX_DELETE_FRACTION=0.20
MAX_DELETE_COUNT=50
TOMBSTONE_TTL_DAYS=30
HOST=127.0.0.1
PORT=8000
