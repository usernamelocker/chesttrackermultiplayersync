# Copy these into Portainer → Stack → Environment variables (NOT the YAML).
# You do NOT need to edit the grey recipe box — just fill the table below it.
# Pre-filled for fabriccraft (both addresses share one bank). Just Deploy.
EXPECTED_SERVER_ID=multiplayer/fabriccraft_net
SERVER_ID_ALIASES=multiplayer/vip_fabriccraft_net
# --- pick ONE access mode ---
# UUID mode: list friends here, leave SHARED_TOKEN empty
# WHITELIST_UUIDS=uuid-of-friend-1,uuid-of-friend-2
# Token mode (simpler): leave WHITELIST_UUIDS empty, set a password instead.
# Everyone who knows the password can sync. Make it long and random.
WHITELIST_UUIDS=
SHARED_TOKEN=change-me-to-a-long-random-password
# Admin password for /cmsync wipealldata (MUST differ from SHARED_TOKEN).
# Entered in-game under CM Settings (never the Sync tab token box).
# WARNING: escape every $ as $$ in Portainer/compose values (abc$X -> abc$$X),
# or compose eats it and the stored token won't match what you type.
ADMIN_TOKEN=
SNAPSHOT_INTERVAL_MIN=15
SNAPSHOT_KEEP=96
MAX_DELETE_FRACTION=0.20
MAX_DELETE_COUNT=50
MIN_QUARANTINE_BANK=10
RANGE_BLOCKS=5000
MAX_UPDATE_FUTURE_SECONDS=300
TOMBSTONE_TTL_DAYS=30
