# Copy these into Portainer → Stack → Environment variables (NOT the YAML).
# YAML = the grey recipe box. You do NOT need to edit it — just fill these 2 boxes below it.
EXPECTED_SERVER_ID=multiplayer/mc_YOURSERVER_IP
WHITELIST_UUIDS=uuid-of-friend-1,uuid-of-friend-2
# Leave these empty for now (no password). Add later if you want one.
SHARED_TOKEN=
ADMIN_TOKEN=
SNAPSHOT_INTERVAL_MIN=15
SNAPSHOT_KEEP=96
MAX_DELETE_FRACTION=0.20
MAX_DELETE_COUNT=50
TOMBSTONE_TTL_DAYS=30
